<?xml version="1.0"?>

<!--
Sample license text.
-->

<configuration>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5"/></startup>
  <runtime>
    <gcAllowVeryLargeObjects enabled="true" />
    <!-- Heiflow.Models.dll and Heiflow.Tools.dll are compiled against Newtonsoft.Json 4.5 (both
         projects set SpecificVersion to False, so the build binds to whatever that assembly the
         machine offers), while the only Newtonsoft.Json next to the executable is 13.0.0.0. The
         loader then finds 13 where 4.5 was asked for and fails with "The located assembly's
         manifest definition does not match the assembly reference". HydroEarth.exe.config carries
         the same redirect for the same two assemblies. -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
