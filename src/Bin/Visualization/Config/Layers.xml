<?xml version="1.0" encoding="utf-8"?>
<World Name="Earth" EquatorialRadius="6378137.0" LayerDirectory="Earth" DefalutLatitude="23.2966736" DefalutLongitude="113.151756">
	<!-- The database every layer keeps its tiles in, and the elevation with them: this is the only
	     cache file there is to manage. The settings window writes it, see WorldSettings.TileCacheType
	     and WorldSettings.TileCacheDbPath in SceneWorld.xml, and it is read when the world is loaded,
	     so the two files are kept saying the same thing. -->
	<TileCache>
		<Type>SQLite</Type>
		<DbFilePath>data\image.gmdb</DbFilePath>
	</TileCache>
	<TerrainAccessor Name="SRTMWMS">
		<!-- The NASA WorldWind WMS that served NASA_SRTM30_900m_Tiled as application/bil16 has been shut
		     down, and no elevation server that is left answers a WMS request with that format, so the
		     WMS service cannot be pointed somewhere else. The elevation comes from the AWS terrain
		     tiles now: they are global, need no key, and are read into the same int16 terrain cache the
		     old service filled, so the tiles that were downloaded from the old server are still used.
		     ServerUrl is a format string of the zoom, the column and the row of the tile. -->
		<TerrariumTerrainTileService>
			<ServerUrl>https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{0}/{1}/{2}.png</ServerUrl>
			<DataSetName>TerrariumTerrain</DataSetName>
			<LevelZeroTileSizeDegrees>20</LevelZeroTileSizeDegrees>
			<NumberLevels>12</NumberLevels>
			<SamplesPerTile>150</SamplesPerTile>
			<DataFormat>Int16</DataFormat>
			<FileExtension>bil</FileExtension>
			<ZoomOffset>4</ZoomOffset>
			<MaxZoom>15</MaxZoom>
			<SQLiteService>
				<DbFilePath>data\image.gmdb</DbFilePath>
				<TerrainType>11</TerrainType>
			</SQLiteService>
		</TerrariumTerrainTileService>
		<LatLonBoundingBox>
			<North>
				<Value>90.0</Value>
			</North>
			<South>
				<Value>-90.0</Value>
			</South>
			<West>
				<Value>-180.0</Value>
			</West>
			<East>
				<Value>180.0</Value>
			</East>
		</LatLonBoundingBox>
	</TerrainAccessor>
	<LayerSet Name="Base Map" ShowOnlyOneLayer="true" ShowAtStartup="true">
	<ProjectedTileSet ShowAtStartup="False">
		<Name>BingSatelliteMap</Name>
		<DistanceAboveSurface>0</DistanceAboveSurface>
		<IconImageName>nrl.png</IconImageName>
		<StartZoomLevel>1</StartZoomLevel>
			<BoundingBox>
			<North>
				<Value>90.0</Value>
			</North>
			<South>
				<Value>-90.0</Value>
			</South>
			<West>
				<Value>-180.0</Value>
			</West>
			<East>
				<Value>180.0</Value>
			</East>
		</BoundingBox>
		<TerrainMapped>true</TerrainMapped>
		<ImageAccessor>
			<LevelZeroTileSizeDegrees>180</LevelZeroTileSizeDegrees>
			<NumberLevels>20</NumberLevels>
			<TextureSizePixels>512</TextureSizePixels>
			<ImageFileExtension>jpeg</ImageFileExtension>
			<SubDatasetName>none</SubDatasetName>
			<IsDebug>False</IsDebug>
			<IsDownloadableLayer>False</IsDownloadableLayer>
			<ImageTileService>
					<ServerUrl>http://worldwind25.arc.nasa.gov/tile/tile.aspx</ServerUrl>
					<DataSetName>BingSatelliteMap</DataSetName>
					<ServerLogoFilePath>Data\Icons\Interface\usgs.png</ServerLogoFilePath>
					<MapProvider>BingSatelliteMap</MapProvider>
					<CacheDirectory>BingSatelliteMap</CacheDirectory>
					<SQLiteService>
		  	  <DbFilePath>data\image.gmdb</DbFilePath>
					  <ImageType>7</ImageType>
		      </SQLiteService>
		  </ImageTileService>		 
		</ImageAccessor>
		<TransparentColor><Red>0</Red><Green>0</Green><Blue>0</Blue></TransparentColor>
	  </ProjectedTileSet>
		<QuadTileSet ShowAtStartup="True">
			<Name>Landsat7 Image</Name>
			<IconImageName>osmlogo.png</IconImageName>
			<DistanceAboveSurface>0</DistanceAboveSurface>
			<StartZoomLevel>5</StartZoomLevel>
			<BoundingBox>
				<North>
					<Value>90.0</Value>
				</North>
				<South>
					<Value>-90.0</Value>
				</South>
				<West>
					<Value>-180.0</Value>
				</West>
				<East>
					<Value>180.0</Value>
				</East>
			</BoundingBox>
			<!-- This is what decides whether a tile mesh follows the elevation: QuadTile.CreateTileMesh
		     only calls CreateElevatedMesh when this is true and VerticalExaggeration is not ~0,
		     otherwise it builds a flat mesh and the globe has no relief at all. It was switched
		     off while the profiling was going on, keep it on. -->
			<TerrainMapped>true</TerrainMapped>
			<ImageAccessor>
				<LevelZeroTileSizeDegrees>36</LevelZeroTileSizeDegrees>
				<NumberLevels>9</NumberLevels>
				<TextureSizePixels>512</TextureSizePixels>
				<ImageFileExtension>jpeg</ImageFileExtension>
				<SubDatasetName>none</SubDatasetName>
				<IsDownloadableLayer>True</IsDownloadableLayer>
				<IsDebug>False</IsDebug>
				<!-- The NASA WorldWind WMS that served the Landsat mosaic as layer esat has been shut down and
			     worldwind25.arc.nasa.gov no longer resolves, so every tile request came back empty and the
			     layer showed nothing. It is pointed at NASA GIBS now, which serves the global Landsat WELD
			     true colour composite over WMS and needs no key. WmsImageStore requests it with lower case
			     GetMap parameters, crs=CRS:84 and a lon,lat bounding box, which is the axis order GIBS
			     expects for that crs, and it answers with the png named in ImageFileExtension. Note that
			     GIBS throttles bursts: too many tiles too fast get an html error instead of an image, so
			     NumberLevels tops out at 9, where level 8 already resolves about 30 m per pixel, the
			     resolution the composite is made at. The cascading layers below that are pure
			     interpolation. The name has to stay Landsat7 Image, it is matched by string in
			     SceneWindow.cs. -->
				<WMSImageTileService>
					<ImageFormat>image/jpeg</ImageFormat>
					<ServerUrl>https://gibs.earthdata.nasa.gov/wms/epsg4326/best/wms.cgi</ServerUrl>
					<Version>1.3.0</Version>
					<LayerNames>Landsat_WELD_CorrectedReflectance_TrueColor_Global_Annual</LayerNames>
					<ServerLogoFilePath>Data\Icons\Interface\usgs.png</ServerLogoFilePath>
					<Opacity>100</Opacity>
					<CacheDirectory>LandsatWELD</CacheDirectory>
					<!-- It follows World.Settings.TileCacheType in SceneWorld.xml, which is File: the
					     tiles are cached as files under CacheDirectory. It used to cache them in
					     data\image.gmdb, where every tile read and every tile written opens a
					     connection to it, and the download threads write 512x512 blobs into it all the
					     time, so the update thread was made to wait seconds for a read (measured:
					     "tile: sqlite cache read" up to 30 ms a call, "TerrainAccessor.
					     GetElevationAt", which reads the terrain out of the same database, up to 5 s).
					     Set TileCacheType to SQLite to put them back in the shared database: the
					     tiles that are already on disk are read from there and copied in as they are
					     shown, so nothing has to be downloaded twice. The number that keeps its tiles
					     apart from the other layers in there is written down below, so it keeps them
					     when its name is changed. -->
					<SQLiteService>
						<DbFilePath>data\image.gmdb</DbFilePath>
						<ImageType>1</ImageType>
					</SQLiteService>
				</WMSImageTileService>
			</ImageAccessor>
			<TransparentColor>
				<Red>0</Red>
				<Green>0</Green>
				<Blue>0</Blue>
			</TransparentColor>
		</QuadTileSet>
	</LayerSet>
</World>