		<!-- Esri World Imagery: web mercator tiles up to level 19, i.e. sub metre pixels in places,
		     which is what the Landsat mosaic cannot deliver. ServerUrl is kept for the parser, the
		     address a tile is fetched from is built by the provider named in MapProvider. -->
		<ImageAccessor>
			<LevelZeroTileSizeDegrees>180</LevelZeroTileSizeDegrees>
			<NumberLevels>20</NumberLevels>
			<TextureSizePixels>512</TextureSizePixels>
			<ImageFileExtension>jpeg</ImageFileExtension>
			<SubDatasetName>none</SubDatasetName>
			<IsDebug>False</IsDebug>
			<IsDownloadableLayer>False</IsDownloadableLayer>
			<ImageTileService>
					<ServerUrl>https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer</ServerUrl>
					<DataSetName>ArcGISWorldImagery</DataSetName>
					<ServerLogoFilePath>Data\Icons\Interface\usgs.png</ServerLogoFilePath>
					<MapProvider>ArcGIS_World_Imagery_MapProvider</MapProvider>
					<CacheDirectory>ArcGISWorldImagery</CacheDirectory>
					<SQLiteService>
		  	  		<DbFilePath>data\image.gmdb</DbFilePath>
					  	<ImageType>9</ImageType>
		      </SQLiteService>
		  </ImageTileService>		 
		</ImageAccessor>
		<TransparentColor><Red>0</Red><Green>0</Green><Blue>0</Blue></TransparentColor>
	</ProjectedTileSet>
	<ProjectedTileSet ShowAtStartup="False">
		<Name>Tianditu Satellite Image</Name>
		<DistanceAboveSurface>0</DistanceAboveSurface>
		<IconImageName>nrl.png</IconImageName>
		<StartZoomLevel>1</StartZoomLevel>
		<BoundingBox>
			<North>
				<Value>90.0</Value>
			</North>
			<South>
				<Value>-90.0</Value>
			</South>
			<West>
				<Value>-180.0</Value>
			</West>
			<East>
				<Value>180.0</Value>
			</East>
		</BoundingBox>
		<TerrainMapped>true</TerrainMapped>
		<!-- Tianditu (天地图) imagery: WMTS in web mercator, levels 1 to 18, so the layer starts at
		     level 1 and stops at 18. The service refuses a request without a key: put the key into
		     Token below. It has to be a key registered for server side use, a browser key is answered
		     with 403. UserAgent is needed as well: the shared "World Wind" agent is stopped by the
		     WAF in front of the service with "您的请求疑似攻击行为", only an agent that looks like a
		     browser is let through. ServerUrl is kept for the parser, the address a tile is fetched
		     from is built by the provider named in MapProvider. -->
		<ImageAccessor>
			<LevelZeroTileSizeDegrees>180</LevelZeroTileSizeDegrees>
			<NumberLevels>19</NumberLevels>
			<TextureSizePixels>512</TextureSizePixels>
			<ImageFileExtension>jpeg</ImageFileExtension>
			<SubDatasetName>none</SubDatasetName>
			<IsDebug>False</IsDebug>
			<IsDownloadableLayer>False</IsDownloadableLayer>
			<ImageTileService>
					<ServerUrl>https://t0.tianditu.gov.cn/img_w/wmts</ServerUrl>
					<DataSetName>TiandituSatelliteImage</DataSetName>
					<ServerLogoFilePath>Data\Icons\Interface\usgs.png</ServerLogoFilePath>
					<MapProvider>TiandituSatelliteMapProvider</MapProvider>
					<Token></Token>
					<UserAgent>Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36</UserAgent>
					<CacheDirectory>TiandituSatelliteImage</CacheDirectory>
					<SQLiteService>
		  	  		<DbFilePath>data\image.gmdb</DbFilePath>
					  	<ImageType>10</ImageType>
		      </SQLiteService>
		  </ImageTileService>		 
		</ImageAccessor>
		<TransparentColor><Red>0</Red><Green>0</Green><Blue>0</Blue></TransparentColor>
	</ProjectedTileSet>
	 <QuadTileSet ShowAtStartup="True">
		<Name>Landsat7 Image</Name>
		<IconImageName>osmlogo.png</IconImageName>
		<DistanceAboveSurface>0</DistanceAboveSurface>
		<StartZoomLevel>5</StartZoomLevel>
		<BoundingBox>
			<North>
				<Value>90.0</Value>
			</North>
			<South>
				<Value>-90.0</Value>
			</South>
			<West>
				<Value>-180.0</Value>
			</West>
			<East>
				<Value>180.0</Value>
			</East>
		</BoundingBox>
		<TerrainMapped>true</TerrainMapped>
		<ImageAccessor>
			<LevelZeroTileSizeDegrees>36</LevelZeroTileSizeDegrees>
			<NumberLevels>11</NumberLevels>
			<TextureSizePixels>512</TextureSizePixels>
			<ImageFileExtension>png</ImageFileExtension>
			<SubDatasetName>none</SubDatasetName>
		  <IsDownloadableLayer>True</IsDownloadableLayer>
			<IsDebug>False</IsDebug>
			<!-- The NASA WorldWind WMS (worldwind26.arc.nasa.gov) has been shut down, so the imagery now
			     comes from NASA GIBS (Global Imagery Browse Services): it is global, needs no key and
			     answers a plain WMS 1.3.0 GetMap request. The layer is the global annual Landsat
			     (WELD) true-colour mosaic, i.e. the same kind of imagery the old Landsat7 layer served.
			     Because ServerUrl contains '?', WmsImageStore only substitutes {WIDTH} {HEIGHT}
			     {WEST} {SOUTH} {EAST} {NORTH}, which lets the request carry SERVICE=WMS and the
			     CRS:84 (lon,lat) bbox order the code always produces.
			     Other usable GIBS layers for the same endpoint:
			       MODIS_Terra_CorrectedReflectance_TrueColor, BlueMarble_ShadedRelief_Bathymetry
			     (see https://gibs.earthdata.nasa.gov/wms/epsg4326/best/wms.cgi?SERVICE=WMS&amp;REQUEST=GetCapabilities) -->
			<WMSImageTileService>
					<ImageFormat>image/png</ImageFormat>
					<ServerUrl>https://gibs.earthdata.nasa.gov/wms/epsg4326/best/wms.cgi?SERVICE=WMS&amp;REQUEST=GetMap&amp;LAYERS=Landsat_WELD_CorrectedReflectance_TrueColor_Global_Annual&amp;CRS=CRS:84&amp;BBOX={WEST},{SOUTH},{EAST},{NORTH}&amp;WIDTH={WIDTH}&amp;HEIGHT={HEIGHT}&amp;FORMAT=image/png&amp;VERSION=1.3.0&amp;STYLES=</ServerUrl>
					<Version>1.3.0</Version>
					<LayerNames>Landsat_WELD_CorrectedReflectance_TrueColor_Global_Annual</LayerNames>
					<ServerLogoFilePath>Data\Icons\Interface\usgs.png</ServerLogoFilePath>
					<Opacity>100</Opacity>
					<CacheDirectory>LandsatGIBS</CacheDirectory>
						<SQLiteService>
		  	      <DbFilePath>data\image.gmdb</DbFilePath>
					     <ImageType>8</ImageType>
		      </SQLiteService>
		  </WMSImageTileService>
		</ImageAccessor>
		<TransparentColor><Red>0</Red><Green>0</Green><Blue>0</Blue></TransparentColor>
	 </QuadTileSet>
  </LayerSet>
