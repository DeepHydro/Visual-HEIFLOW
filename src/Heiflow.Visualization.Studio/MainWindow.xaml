        <Grid x:Name="MainGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Scene3DBorder">
                <WindowsFormsHost  Margin="0"  x:Name="winhostMain">
                    <ww:SceneWindow x:Name="sceneWindow"   Dock="Fill"  IsRenderDisabled="False" Text="worldWindow"></ww:SceneWindow>
                </WindowsFormsHost>
            </Border>
            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"   Margin="0" Padding="0"  Background="{DynamicResource CommonBrush}"/>
            <TabControl Margin="0" Grid.Column="2" >
                <TabItem Header="Layers" IsSelected="True" >
                    <localct:LayerManager x:Name="_LayerManager" Margin="0" ></localct:LayerManager>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Controls:MetroWindow>