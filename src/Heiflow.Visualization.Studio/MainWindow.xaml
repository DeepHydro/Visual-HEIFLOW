            </Button>
            <Button x:Name="btnSceneSetting" DockPanel.Dock="Right"  Width="40" Margin="0,0,5,0" Tag="1"  
                    HorizontalAlignment="Right"  ToolTip="SceneSetting" Click="btnVisSetting_Click">
                <Button.Content>
                    <Path Width="20" Height="20" Canvas.Left="19" Canvas.Top="23" Stretch="Fill" Fill="{DynamicResource CommonBrush}" Data="F1 M 21,36L 25,36L 25,40L 21,40L 21,36 Z M 19,23L 27,23L 27,31L 19,31L 19,23 Z M 19,34L 27,34L 27,42L 19,42L 19,34 Z M 31,23L 57,23L 57,31L 31,31L 31,23 Z M 19,45L 27,45L 27,53L 19,53L 19,45 Z M 31,34L 57,34L 57,42L 31,42L 31,34 Z M 31,45L 57,45L 57,53L 31,53L 31,45 Z M 20,35L 20,41L 26,41L 26,35L 20,35 Z "/>
                </Button.Content>
            </Button>
