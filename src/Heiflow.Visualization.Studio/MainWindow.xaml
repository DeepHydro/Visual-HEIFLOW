<Controls:MetroWindow x:Class="Heiflow.Visualization.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
         xmlns:ww="clr-namespace:HUST.WREIS.Dot3D;assembly=Heiflow.Visualization.Display"
        xmlns:wpg="clr-namespace:WPG;assembly=WPG"
          xmlns:heict="clr-namespace:Heiflow.Presentation.Controls.Project;assembly=Heiflow.Controls.WinForm"              
        xmlns:System="clr-namespace:System;assembly=mscorlib" Title="Hydro Earth"                
        xmlns:localct="clr-namespace:Heiflow.Visualization.Studio.Controls"
        Height="800" Width="1000" WindowStartupLocation="CenterScreen" TitleForeground="#999988"  Icon="Images\wc_logo32.png"               
      WindowStyle="SingleBorderWindow" WindowState="Maximized" ShowMaxRestoreButton="True" Background="{DynamicResource ControlBackgroundBrush}">
    <Controls:MetroWindow.Flyouts>
        <Controls:FlyoutsControl x:Name="flyoutsControl" HorizontalAlignment="Left" Background="Black" OpacityMask="{DynamicResource ControlBackgroundBrush}">
            <Controls:Flyout Header="Scene Setting" Position="Left" HorizontalAlignment="Left" 
                             AnimateOpacity="True"  Width="300" Margin="0,0,0,0" Background="{DynamicResource CommonBrush}" Visibility="Visible" OpacityMask="{DynamicResource ControlBackgroundBrush}" Theme="Light">
                <localct:SceneSetting></localct:SceneSetting>
            </Controls:Flyout>
        </Controls:FlyoutsControl>
    </Controls:MetroWindow.Flyouts>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <DockPanel DockPanel.Dock="Top" SnapsToDevicePixels="True" Margin="0,0,0,0" Grid.Row="0" Background="{DynamicResource CommonBrush}">
            <Menu DockPanel.Dock="Left" SnapsToDevicePixels="True" Margin="0" Style="{StaticResource GeneralMenu}">
                <MenuItem Header="{DynamicResource FileMenuHeader}"  x:Name="NewMenu"   >
                    <MenuItem  Header="{DynamicResource OpenPrjMenuHeader}"  x:Name="miLoadHeiflow"  Click="FileLoadHeiflow_Click"/>
                    <Separator />
                    <MenuItem  Header="{DynamicResource SavePrjMenuHeader}"  x:Name="miSaveHeiflow"  Click="FileSaveHeiflow_Click"/>
                    <Separator />
                    <MenuItem Header="{DynamicResource LanguageMenuHeader}"  >
                        <MenuItem Header="{DynamicResource EnglishMenuHeader}"   Click="OnLoadEnglishClick"/>
                        <MenuItem Header="{DynamicResource ChineseMenuHeader}"   Click="OnLoadChineseClick" />
                    </MenuItem>
                    <MenuItem Header="Style" Visibility="Collapsed">
                        <MenuItem Header="Blue" Click="StyleMenuItem_Click"></MenuItem>
                        <MenuItem Header="Green" Click="StyleMenuItem_Click"></MenuItem>
                        <MenuItem Header="Black" Click="StyleMenuItem_Click"></MenuItem>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource  ExitMenuHeader}"   x:Name="miExit"  Click="miExit_Click"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource  ViewMenuHeader}" x:Name="ViewMenu"  >
                    <MenuItem Header="{DynamicResource  ShowPosInfoMenuHeader}"   IsCheckable="True"   x:Name="miPositionInfo"  IsChecked="True"  Click="ViewMenuItem_Click" />
                    <MenuItem Header="{DynamicResource  ShowCroHairMenuHeader}" IsCheckable="True"  x:Name="miHasCrossHairs"  IsChecked="True"  Click="ViewMenuItem_Click" />
                    <MenuItem Header="{DynamicResource  ShowLatlngMenuHeader}" IsCheckable="True"  x:Name="miShowLatLong"  IsChecked="False"  Click="ViewMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="{DynamicResource  ShowCompassMenuHeader}" IsCheckable="True"  x:Name="miHasCompass"  IsChecked="True"  Click="ViewMenuItem_Click" />
                    <MenuItem Header="{DynamicResource  ShowScalebarMenuHeader}"  x:Name="miShowScaleBar" IsCheckable="True"  IsChecked="True" Click="ViewMenuItem_Click" />
                    <MenuItem Header="{DynamicResource  ShowLengendMenuHeader}"   x:Name="miGridLengend"  Click="ViewMenuItem_Click"/>
                    <Separator />
                    <MenuItem Header="{DynamicResource  EnInertiaMenuHeader}" IsCheckable="True"  x:Name="miCameraHasInertia"  Click="ViewMenuItem_Click" />
                    <MenuItem Header="{DynamicResource  EnMoveMoMenuHeader}" IsCheckable="True"  x:Name="miCameraHasMoment"  IsChecked="True"  Click="ViewMenuItem_Click"  />
                    <MenuItem Header="{DynamicResource  EnFogMenuHeader}" IsCheckable="True"  x:Name="miDisplayFog"  Click="ViewMenuItem_Click" Visibility="Collapsed"/>
                    <MenuItem Header="{DynamicResource  EnSolarMenuHeader}" IsCheckable="True"  x:Name="miSunshading"  IsChecked="False"  Click="ViewMenuItem_Click" />
                    <MenuItem Header="{DynamicResource  EnSkyMenuHeader}" IsCheckable="True"  x:Name="miHasSky"  IsChecked="True"  Click="ViewMenuItem_Click" Visibility="Collapsed" />
                    <MenuItem Header="{DynamicResource  EnAtomosphereMenuHeader}" IsCheckable="True"  x:Name="miHasAtmosphere"  IsChecked="False"  Click="ViewMenuItem_Click" Visibility="Collapsed"/>
                    <MenuItem Header="{DynamicResource  EnSkyMenuHeader}" IsCheckable="True"  x:Name="miHasAtmosphereScattering"  IsChecked="False"  Click="ViewMenuItem_Click" />
                    <MenuItem Header="High Perfomance" IsCheckable="True"  x:Name="_EnableHighPerfomance"  IsChecked="False"  Click="ViewMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="{DynamicResource  ShowChartMenuHeader}"   x:Name="miShowChart"  IsCheckable="True"  Click="ViewMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="{DynamicResource  DefaultPosMenuHeader}"  x:Name="miGotoDefault" Click="miGotoDefault_Click" />
                    <MenuItem Header="{DynamicResource  CurrentPosAsDefaultMenuHeader}"  x:Name="miCurrentPosAsDefault" Click="miCurrentPosAsDefault_Click" />
                    <MenuItem Header="{DynamicResource  ViewpropMenuHeader}"  x:Name="miViewProperty" Click="ViewMenuItem_Click" />
                    <MenuItem Header="{DynamicResource  SaveConfigMenuHeader}"  x:Name="miSaveViewSetting" Click="ViewMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="{DynamicResource  DataMenuHeader}" x:Name="DataMenu"    >
                    <MenuItem Header="Add Vector"   x:Name="miLoadShp"  Click="miLoadShp_Click"/>
                    <MenuItem Header="Add Raster"   x:Name="miLoadRater"  Click="miLoadRaster_Click"/>
                    <MenuItem Header="Add 3D Model"   x:Name="miLoad3DModel"  Click="miLoad3DModel_Click"/>
                    <Separator />
                    <MenuItem Header="Load ODM Database"   x:Name="miLoadODM"  Click="miLoadODM_Click"/>
                    <MenuItem Header="Search Sites"   x:Name="miSearchSites"  Click="miSearchSites_Click"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource  ToolMenuHeader}"  x:Name="ToolMenu"   >
                    <MenuItem Header="{DynamicResource  ShowStatInfoMenuHeader}"   x:Name="miShowStatInfo"  Click="miShowStatInfo_Click"/>
                    <MenuItem Header="{DynamicResource  D3PerfMenuHeader}"  IsCheckable="True"  x:Name="miDis3DRenderInfo"  IsChecked="False" Click="ToolMenuItem_Click"/>
                    <MenuItem Header="{DynamicResource  MeasureMenuHeader}"  IsCheckable="True"  x:Name="miMeasure"  IsChecked="False" Click="ToolMenuItem_Click"/>
                    <MenuItem Header="{DynamicResource  ScreenShotMenuHeader}"   x:Name="miScreenShot"  Click="ToolMenuItem_Click"/>
                    <MenuItem Header="{DynamicResource  AutoScreenShotMenuHeader}"   x:Name="miAutoScreenShot" IsChecked="True" IsCheckable="True"  Click="ToolMenuItem_Click" Visibility="Collapsed"/>
                    <MenuItem Header="{DynamicResource  MakeMovieMenuHeader}"    x:Name="miMakeMovie"   Click="ToolMenuItem_Click" Visibility="Collapsed"/>
                    <MenuItem Header="Extract Terrain"    x:Name="miExtractTerrain"   Click="ToolMenuItem_Click" Visibility="Visible"/>
                    <MenuItem Header="Export MIKE file"    x:Name="miExtractMike"   Click="ToolMenuItem_Click" Visibility="Visible"/>
                    <MenuItem Header="Import MIKE Mesh"    x:Name="miImportMikeMesh"   Click="ToolMenuItem_Click" Visibility="Visible"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource  HelpMenuHeader}" x:Name="HelpMenu"  >
                    <MenuItem Header="{DynamicResource  ViewHelpMenuHeader}" Visibility="Collapsed" />
                    <MenuItem Header="{DynamicResource  AboutMenuHeader}" x:Name="btnAbout" Click="btnAbout_Click"/>
                </MenuItem>
            </Menu>

            <ComboBox DockPanel.Dock="Right" HorizontalAlignment="Right" Width="200" Margin="0,0,10,0" x:Name="cmbLayer" Text="select a layer" SelectionChanged="cmbLayer_SelectionChanged"
                          Controls:TextBoxHelper.Watermark="Please select a layer..." ToolTip="Please select a layer...">
            </ComboBox>
            <Button  x:Name="btnAnimate" DockPanel.Dock="Right"  Width="40" Margin="0,0,5,0" Tag="2"  HorizontalAlignment="Right" 
                 ToolTip="Animaiton Player"    Click="btnVisSetting_Click">
