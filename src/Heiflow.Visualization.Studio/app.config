<?xml version="1.0"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
      <section name="Heiflow.Visualization.Studio.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
    <supportedRuntime version="v1.1.4322"/>
  </startup>
  <!-- Heiflow.Core is built against Newtonsoft.Json 13 while Heiflow.Models and Heiflow.Tools still
       carry a reference to 4.5, and only the 13 assembly is next to the executable. Without the
       redirect the assembly that asks for 4.5 fails to load with "找到的程序集清单定义与程序集引用
       不匹配" as soon as VGSManager.Run() composes the modules. -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <!-- 构建报告的版本冲突，目标版本均已确认存在于输出目录/依赖目录，统一重定向以免运行期加载失败。
           注意 ICSharpCode.SharpZipLib 未在此重定向：构建提示的 0.86.0.518 在磁盘上并不存在
           （所有副本实际为 0.85.5.452），若重定向过去反而会导致程序集无法加载。 -->
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="DotSpatial.Serialization" publicKeyToken="441f200f827611e7" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <applicationSettings>
    <Heiflow.Visualization.Studio.Properties.Settings>
      <setting name="ModuleAssemblies" serializeAs="Xml">
        <value>
          <ArrayOfString xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <string>HydroEarth.exe</string>
          </ArrayOfString>
        </value>
      </setting>
    </Heiflow.Visualization.Studio.Properties.Settings>
  </applicationSettings>
</configuration>
