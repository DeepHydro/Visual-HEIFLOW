<Controls:MetroWindow  x:Class="Heiflow.Visualization.Studio.Controls.SeachSitesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"     
     xmlns:input="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
        Title="Search Sites" Height="230" Width="430" ShowMinButton="False" ShowMaxRestoreButton="False">
    <Grid Background="{DynamicResource CommonBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="150"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0"  Orientation="Horizontal" Grid.ColumnSpan="2" >
            <input:AutoCompleteBox  x:Name="tbKeyword" Width="300" Height="32" Margin="5"></input:AutoCompleteBox>
            <Button x:Name="btnSearch" Width="100" Height="32" Margin="5" HorizontalAlignment="Right" Click="btnSearch_Click">Search</Button>
        </StackPanel>
        <StackPanel Grid.Row="1"  Orientation="Vertical"  Grid.Column="0">
            <TextBlock Style="{DynamicResource CaptionText}">Start</TextBlock>
            <DatePicker x:Name="dateStart" Height="32" Margin="2"></DatePicker>
            <TextBlock  Style="{DynamicResource CaptionText}">End</TextBlock>
            <DatePicker x:Name="dateEnd" Height="32" Margin="2"></DatePicker>
        </StackPanel>
        <Grid Grid.Row="1" Grid.Column="1" >
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBox  x:Name="tbNLat" Grid.Row="0" Grid.Column="1"  Style="{DynamicResource InputTextBox}" Margin="10">90</TextBox>
            <TextBox x:Name="tbWLng" Grid.Row="1" Grid.Column="0"  Style="{DynamicResource InputTextBox}" Margin="10">-180</TextBox>
            <TextBox x:Name="tbElng" Grid.Row="1" Grid.Column="2"  Style="{DynamicResource InputTextBox}" Margin="10">180</TextBox>
            <TextBox x:Name="tbSLat" Grid.Row="2" Grid.Column="1"  Style="{DynamicResource InputTextBox}" Margin="10">-90</TextBox>
            <Border Grid.Row="1" Grid.Column="1" BorderBrush="#FFC01E1E"  BorderThickness="3" ></Border>
            <Button x:Name="btnDraw" Height="32" Margin="5" Grid.Row="2" Grid.Column="2">Draw</Button>
        </Grid>
    </Grid>
</Controls:MetroWindow>
