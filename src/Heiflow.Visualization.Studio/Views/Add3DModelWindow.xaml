<Controls:MetroWindow x:Class="Heiflow.Visualization.Studio.Controls.Add3DModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"     
        xmlns:wpg="clr-namespace:WPG;assembly=WPG"
        Title="Add 3D Object" Height="300" Width="360" ShowMinButton="False" ShowMaxRestoreButton="False" ShowInTaskbar="False">
    <Grid Background="{DynamicResource CommonBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Style="{DynamicResource CaptionText}" Text="Location:"></TextBlock>
            <TextBox x:Name="tbFile" Style="{DynamicResource InputTextBox}" Width="200"></TextBox>
            <Button x:Name="btnBrowse" Content="Browse..." Margin="8"  Width="80" Click="btnBrowse_Click"></Button>
        </StackPanel>
        <wpg:PropertyGrid x:Name="propertyGrid" Grid.Row="1" ></wpg:PropertyGrid>
        <DockPanel Grid.Row="2" >
            <Button x:Name="btnClose"  Content="Close" Margin="8,8,30,8" Width="80" DockPanel.Dock="Right" Click="btnClose_Click"></Button>
            <Button x:Name="btnAdd" Content="Add" Margin="8,8,-50,8" Width="80" DockPanel.Dock="Right" Click="btnAdd_Click"></Button>
        </DockPanel>
    </Grid>
</Controls:MetroWindow>
