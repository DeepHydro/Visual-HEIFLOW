<UserControl x:Class="Heiflow.Visualization.Studio.Controls.AnimationPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"  Background="{DynamicResource CommonBrush}"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             d:DesignHeight="400" d:DesignWidth="300">
    <!-- Redrawn so that it looks like the other panels of the shell: same palette, same card per group,
         same property grid. The player had its own brushes, a light framework combo box and a white
         framework check box, and the transport buttons were drawn by a style that belongs to another
         window.

         The panel is hosted in a window of a fixed height, so it scrolls inside its own scroller now
         instead of being cut off. Only the way it is drawn changed: the names of the controls and their
         event handlers are exactly the ones AnimationPlayer.xaml.cs expects, and the play, pause and stop
         handlers are still attached in the code behind while rewind and forward stay in the markup. -->
    <UserControl.Resources>

        <!-- Palette of the panel, taken from the dark skin of the application. -->
        <SolidColorBrush x:Key="PlayerSectionBackground" Color="#FF26272B" />
        <SolidColorBrush x:Key="PlayerHeaderBackground" Color="#FF31333A" />
        <SolidColorBrush x:Key="PlayerControlBackground" Color="#FF1E1F23" />
        <SolidColorBrush x:Key="PlayerDropDownBackground" Color="#FF2A2C31" />
        <SolidColorBrush x:Key="PlayerBorderBrush" Color="#FF3B3E46" />
        <SolidColorBrush x:Key="PlayerHoverBrush" Color="#FF3A3D45" />
        <SolidColorBrush x:Key="PlayerAccentBrush" Color="#FF4EA1DE" />
        <SolidColorBrush x:Key="PlayerTextBrush" Color="#FFE8EAED" />
        <SolidColorBrush x:Key="PlayerLabelBrush" Color="#FFAEB4BF" />
        <SolidColorBrush x:Key="PlayerTrackBrush" Color="#FF141518" />

        <!-- Label of a property, the controls of every section start at the same offset. -->
        <Style x:Key="PlayerFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PlayerLabelBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style x:Key="PlayerValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PlayerTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Elapsed time, state and total time under the transport buttons. -->
        <Style x:Key="PlayerTimeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PlayerLabelBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Header of a group. -->
        <Style x:Key="PlayerGroupTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PlayerTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PlayerSliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="12" Height="12" Fill="{StaticResource PlayerControlBackground}"
                                 Stroke="{StaticResource PlayerAccentBrush}" StrokeThickness="1.5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerTrackFillButton" TargetType="RepeatButton">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{StaticResource PlayerAccentBrush}" Height="4" CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerTrackButton" TargetType="RepeatButton">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{StaticResource PlayerTrackBrush}" Height="4" CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat slider with a thin track. The slider walks the time steps one by one, so a tick bar
             would be a solid grey block and is left out. -->
        <Style x:Key="PlayerSlider" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="TickPlacement" Value="None" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Height="16">
                                <Border Height="4" CornerRadius="2" Background="{StaticResource PlayerTrackBrush}" />
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource PlayerTrackFillButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource PlayerSliderThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource PlayerTrackButton}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <TickBar x:Name="BottomTick" Grid.Row="1" Height="4" Placement="Bottom"
                                     Fill="{StaticResource PlayerLabelBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerComboBoxToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{StaticResource PlayerControlBackground}"
                                BorderBrush="{StaticResource PlayerBorderBrush}" BorderThickness="1" CornerRadius="3">
                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource PlayerLabelBrush}" StrokeThickness="1.5"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PlayerAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PlayerAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource PlayerTextBrush}" />
            <Setter Property="Padding" Value="6,4,6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PlayerHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PlayerAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF7A7A7A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The date box is filled from the code behind with the dates of the data cube, so the items are
             not combo box items. The item container style takes care of them as well. -->
        <Style x:Key="PlayerComboBox" TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource PlayerTextBrush}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PlayerComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource PlayerComboBoxToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter IsHitTestVisible="False" Margin="7,0,22,0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   PopupAnimation="Slide" AllowsTransparency="True" Focusable="False">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220" Margin="0,2,0,0"
                                        Background="{StaticResource PlayerDropDownBackground}"
                                        BorderBrush="{StaticResource PlayerBorderBrush}" BorderThickness="1" CornerRadius="3">
                                    <ScrollViewer Margin="2" Foreground="{StaticResource PlayerTextBrush}">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerCheckBox" TargetType="CheckBox">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource PlayerTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="14" Height="14" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{StaticResource PlayerControlBackground}"
                                    BorderBrush="{StaticResource PlayerBorderBrush}" BorderThickness="1">
                                <Path x:Name="Check" Data="M 2,7 L 6,11 L 12,3" Stroke="{StaticResource PlayerAccentBrush}"
                                      StrokeThickness="2" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PlayerAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PlayerAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Create cache and clear cache. -->
        <Style x:Key="PlayerButton" TargetType="Button">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource PlayerTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource PlayerControlBackground}"
                                BorderBrush="{StaticResource PlayerBorderBrush}" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PlayerHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PlayerAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PlayerAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rewind, play, pause, stop and forward. The glyphs are drawn by the content, the button only
             gives them a dark plate, so a disabled button is still recognisable. -->
        <Style x:Key="PlayerIconButton" TargetType="Button">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource PlayerControlBackground}"
                                BorderBrush="{StaticResource PlayerBorderBrush}" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PlayerHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PlayerAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PlayerAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PlayerBorderBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PlayerTrackBrush}" />
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerProgressBar" TargetType="ProgressBar">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource PlayerAccentBrush}" />
            <Setter Property="Background" Value="{StaticResource PlayerTrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Rectangle Fill="{TemplateBinding Foreground}" RadiusX="2" RadiusY="2" />
                            </Decorator>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Every section is a card: a header with an accent bar and a body that holds the properties. -->
        <Style x:Key="PlayerExpander" TargetType="Expander">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource PlayerTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{StaticResource PlayerSectionBackground}"
                                BorderBrush="{StaticResource PlayerBorderBrush}" BorderThickness="1" CornerRadius="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ToggleButton Grid.Row="0" Focusable="False"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ToolTip="{TemplateBinding Header}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderBd" Background="{StaticResource PlayerHeaderBackground}"
                                                    CornerRadius="3,3,0,0" Padding="0" SnapsToDevicePixels="True">
                                                <Grid Height="30">
                                                    <Rectangle Width="3" HorizontalAlignment="Left" Fill="{StaticResource PlayerAccentBrush}" />
                                                    <ContentPresenter Margin="11,0,10,0" VerticalAlignment="Center" />
                                                    <Path x:Name="Chevron" Data="M 0 0 L 4 4 L 0 8"
                                                          Stroke="{StaticResource PlayerLabelBrush}" StrokeThickness="1.5"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"
                                                          RenderTransformOrigin="0.5,0.5" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderBd" Property="Background" Value="{StaticResource PlayerHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}" />
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite" Grid.Row="1" Margin="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0" Background="Transparent">
        <StackPanel Margin="5,5,5,5">

            <Expander x:Name="expPlayer" Style="{StaticResource PlayerExpander}">
                <Expander.Header>
                    <TextBlock Text="Player" Style="{StaticResource PlayerGroupTitle}" />
                </Expander.Header>
                <Grid Margin="11,9,11,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Name of the variable that is animated, set from the code behind. -->
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" x:Name="tbAniVarName" Margin="0,0,0,9"
                               Text="Animated Variable: " Style="{StaticResource PlayerValueText}"
                               HorizontalAlignment="Left" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource AniSpeedTxt}" Style="{StaticResource PlayerFieldLabel}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cobAnimateVelocity" Style="{StaticResource PlayerComboBox}"
                              IsSynchronizedWithCurrentItem="False" SelectedIndex="1"
                              SelectionChanged="cobAnimateVelocity_SelectionChanged">
                        <ComboBoxItem IsSelected="True" Content="{DynamicResource FastTxt}" Tag="50"></ComboBoxItem>
                        <ComboBoxItem IsSelected="False" Content="{DynamicResource NormalTxt}" Tag="100"></ComboBoxItem>
                        <ComboBoxItem IsSelected="False" Content="{DynamicResource SlowTxt}" Tag="200"></ComboBoxItem>
                        <ComboBoxItem IsSelected="False" Content="{DynamicResource VerySlowTxt}" Tag="300"></ComboBoxItem>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource AniDatesTxt}" Style="{StaticResource PlayerFieldLabel}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cmbDates" Style="{StaticResource PlayerComboBox}"
                              IsSynchronizedWithCurrentItem="False" SelectionChanged="cmbDates_SelectionChanged" />

                    <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,9,0,2">
                        <TextBlock x:Name="CurrentTime" Text="0:00" Style="{StaticResource PlayerTimeText}" HorizontalAlignment="Left" />
                        <TextBlock x:Name="Status" Text="" Style="{StaticResource PlayerTimeText}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TotalTime" Text="" Style="{StaticResource PlayerTimeText}" HorizontalAlignment="Right" />
                    </Grid>

                    <Slider Grid.Row="4" Grid.ColumnSpan="2" x:Name="sliderPlayPrg" Margin="0,0,0,4"
                            Style="{StaticResource PlayerSlider}" Minimum="0" SmallChange="1.0" Interval="1"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="sliderPlayPrg_ValueChanged" />

                    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Button x:Name="RewindButton" Style="{StaticResource PlayerIconButton}" Margin="3" Click="RewindButton_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Fill="{StaticResource PlayerTextBrush}" Width="3" Height="10" />
                                    <Path Data="M10,0 L10,10 0,5 10,0" Fill="{StaticResource PlayerTextBrush}" />
                                    <Path Data="M10,0 L10,10 0,5 10,0" Fill="{StaticResource PlayerTextBrush}" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource PlayerIconButton}" Margin="3">
                            <Button.Content>
                                <Path Data="M0,0 L10,5 0,10 0,0" Fill="{StaticResource PlayerTextBrush}" />
                            </Button.Content>
                        </Button>
                        <Button x:Name="PauseButton" Style="{StaticResource PlayerIconButton}" Margin="3" IsEnabled="False">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Fill="{StaticResource PlayerTextBrush}" Width="3" Height="10" Margin="0,0,3,0" />
                                    <Rectangle Fill="{StaticResource PlayerTextBrush}" Width="3" Height="10" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button x:Name="StopButton" Style="{StaticResource PlayerIconButton}" Margin="3" IsEnabled="False">
                            <Button.Content>
                                <Rectangle Fill="{StaticResource PlayerTextBrush}" Width="10" Height="10" />
                            </Button.Content>
                        </Button>
                        <Button x:Name="ForwardButton" Style="{StaticResource PlayerIconButton}" Margin="3" Click="ForwardButton_Click">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M0,0 L10,5 0,10 0,0" Fill="{StaticResource PlayerTextBrush}" />
                                    <Path Data="M0,0 L10,5 0,10 0,0" Fill="{StaticResource PlayerTextBrush}" />
                                    <Rectangle Fill="{StaticResource PlayerTextBrush}" Width="3" Height="10" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
            </Expander>

            <Expander x:Name="expCache" Style="{StaticResource PlayerExpander}">
                <Expander.Header>
                    <TextBlock Text="Cache" Style="{StaticResource PlayerGroupTitle}" />
                </Expander.Header>
                <Grid Margin="11,9,11,11">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" x:Name="chkUseCache" Content="Use Cache" Style="{StaticResource PlayerCheckBox}"
                              Checked="chkUseCache_Checked" Unchecked="chkUseCache_Checked" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,0">
                        <Button x:Name="butCacheColor" Content="Create Cache" Style="{StaticResource PlayerButton}"
                                Width="118" Click="ButCacheColor_Click" />
                        <Button x:Name="btnClearCacheColor" Content="Clear Cache" Style="{StaticResource PlayerButton}"
                                Width="118" Margin="8,0,0,0" Click="BtnClearCacheColor" />
                    </StackPanel>

                    <ProgressBar Grid.Row="2" x:Name="cacheProgress" Style="{StaticResource PlayerProgressBar}"
                                 Margin="0,11,0,0" Minimum="0" Maximum="100" />
                </Grid>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
