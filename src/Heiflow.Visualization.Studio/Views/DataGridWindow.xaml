<Controls:MetroWindow x:Class="Heiflow.Visualization.Studio.Controls.DataGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"            
        xmlns:heict="clr-namespace:Heiflow.Controls.WinForm.Controls;assembly=Heiflow.Controls.WinForm"      
        Title="Table View" Height="500" Width="700" ShowInTaskbar="False" Foreground="Black">
    <Grid Margin="2" TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal">
        <WindowsFormsHost >
            <heict:DataCubeGrid x:Name="datagrid" ForeColor="Black" AutoScroll="True" AutoSizeMode="GrowAndShrink" ></heict:DataCubeGrid>
        </WindowsFormsHost>
    </Grid>
</Controls:MetroWindow>
