<Controls:MetroWindow x:Class="Heiflow.Visualization.Studio.Controls.ProjectExplorerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"     
         xmlns:localct="clr-namespace:Heiflow.Visualization.Studio.Controls"            
        Title="Project Explorer" Height="800" Width="300" ShowInTaskbar="False" ShowIconOnTitleBar="False">
    <!-- The project explorer used to be the Windows Forms ProjectExplorerControl inside a WindowsFormsHost.
         It is a native WPF control now, so it scales with the shell and uses the dark skin. -->
    <Grid Margin="2" Background="#FF1B1B1B">
        <localct:LayerManagerView x:Name="_ProjectExplorer" />
    </Grid>
</Controls:MetroWindow>
