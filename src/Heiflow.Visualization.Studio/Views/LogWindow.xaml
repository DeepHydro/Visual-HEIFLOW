<Controls:MetroWindow x:Class="Heiflow.Visualization.Studio.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Title="{DynamicResource LogWindowTitle}" Height="680" Width="1020"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="160" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="{DynamicResource LogFilesGroupHeader}">
            <ListView x:Name="lvFiles">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="32">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Path=Selected, Mode=TwoWay}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{DynamicResource LogColumnFile}" Width="300" DisplayMemberBinding="{Binding Path=Name}" />
                        <GridViewColumn Header="{DynamicResource LogColumnKind}" Width="90" DisplayMemberBinding="{Binding Path=KindText}" />
                        <GridViewColumn Header="{DynamicResource LogColumnSize}" Width="90" DisplayMemberBinding="{Binding Path=SizeText}" />
                        <GridViewColumn Header="{DynamicResource LogColumnModified}" Width="160" DisplayMemberBinding="{Binding Path=ModifiedText}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <GroupBox Grid.Row="1" Margin="0,6,0,0" Header="{DynamicResource LogEntriesGroupHeader}">
            <ListView x:Name="lvEntries" FontFamily="Consolas">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{DynamicResource LogColumnTime}" Width="150" DisplayMemberBinding="{Binding Path=Time}" />
                        <GridViewColumn Header="{DynamicResource LogColumnLevel}" Width="80" DisplayMemberBinding="{Binding Path=LevelText}" />
                        <GridViewColumn Header="{DynamicResource LogColumnCategory}" Width="70" DisplayMemberBinding="{Binding Path=Category}" />
                        <GridViewColumn Header="{DynamicResource LogColumnMessage}" Width="660" DisplayMemberBinding="{Binding Path=Message}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{DynamicResource LogLinesLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="cmbLines" Width="90" IsEditable="True" Margin="0,0,16,0"
                      SelectionChanged="Filter_Changed" />
            <TextBlock Text="{DynamicResource LogLevelLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="cmbLevel" Width="130" Margin="0,0,16,0" SelectionChanged="Filter_Changed" />
            <TextBlock Text="{DynamicResource LogCategoryLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="txtCategory" Width="110" Margin="0,0,16,0" />
            <Button x:Name="btnRefresh" Content="{DynamicResource LogRefresh}" MinWidth="90"
                    HorizontalAlignment="Right" Click="btnRefresh_Click" />
        </DockPanel>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="txtStatus" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnOpenFolder" Content="{DynamicResource LogOpenFolder}" MinWidth="110"
                        Margin="0,0,8,0" Click="btnOpenFolder_Click" />
                <Button x:Name="btnDeleteFiles" Content="{DynamicResource LogDeleteSelected}" MinWidth="120"
                        Margin="0,0,8,0" Click="btnDeleteFiles_Click" />
                <Button x:Name="btnClearLog" Content="{DynamicResource LogClear}" MinWidth="110"
                        Margin="0,0,8,0" Click="btnClearLog_Click" />
                <Button x:Name="btnClose" Content="{DynamicResource LogClose}" MinWidth="90" Click="btnClose_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Controls:MetroWindow>
