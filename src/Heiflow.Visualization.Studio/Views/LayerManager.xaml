<UserControl x:Class="Heiflow.Visualization.Studio.Controls.LayerManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"  Background="{DynamicResource CommonBrush}"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             d:DesignHeight="300" d:DesignWidth="300">
    <!-- Tree of the renderable objects of the 3D scene. It sits in the tab next to the scene settings, so
         it is drawn as the same card: a header with an accent bar and a body that holds the tree. The
         tree itself keeps the shared style of the shell, only the check box and the context menu were
         missing: both were still painted by the framework with the light system colours.

         The styles live in this file on purpose, like the ones of the scene panel: they belong to this
         control and must not change the look of the other views. -->
    <UserControl.Resources>

        <!-- Palette of the panel, taken from the dark skin of the application. -->
        <SolidColorBrush x:Key="LayerCardBackground" Color="#FF26272B" />
        <SolidColorBrush x:Key="LayerHeaderBackground" Color="#FF31333A" />
        <SolidColorBrush x:Key="LayerControlBackground" Color="#FF1E1F23" />
        <SolidColorBrush x:Key="LayerMenuBackground" Color="#FF2A2C31" />
        <SolidColorBrush x:Key="LayerBorderBrush" Color="#FF3B3E46" />
        <SolidColorBrush x:Key="LayerHoverBrush" Color="#FF3A3D45" />
        <SolidColorBrush x:Key="LayerAccentBrush" Color="#FF4EA1DE" />
        <SolidColorBrush x:Key="LayerTextBrush" Color="#FFE8EAED" />
        <SolidColorBrush x:Key="LayerLabelBrush" Color="#FFAEB4BF" />

        <!-- Header of the card, the same one the scene panel uses for a group. -->
        <Style x:Key="LayerGroupTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LayerTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Visibility switch of a layer. Marked and unmarked rows have to be told apart on the dark
             card, the framework check box is a white box with a black tick. -->
        <Style x:Key="LayerCheckBox" TargetType="CheckBox">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource LayerTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="14" Height="14" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{StaticResource LayerControlBackground}"
                                    BorderBrush="{StaticResource LayerBorderBrush}" BorderThickness="1">
                                <Path x:Name="Check" Data="M 2,7 L 6,11 L 12,3" Stroke="{StaticResource LayerAccentBrush}"
                                      StrokeThickness="2" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource LayerAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource LayerAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The items carry no sub menu, so the template is the plain row of a menu. -->
        <Style x:Key="LayerMenuItem" TargetType="MenuItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource LayerTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,5,10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LayerHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF7A7A7A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LayerContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource LayerMenuBackground}"
                                BorderBrush="{StaticResource LayerBorderBrush}" BorderThickness="1" CornerRadius="3">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" Margin="2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LayerItemStyle" TargetType="{x:Type TreeViewItem}"
               BasedOn="{StaticResource LayerTreeViewItemStyle}">
            <Setter Property="IsExpanded" Value="True" />
        </Style>

        <!-- The menu lives in the resources, so x:Name does not reach the name scope and the generated
             code never sets it. The name is set as a plain property because the code behind looks the item
             up by it to enable it for the layers that carry a data table. -->
        <ContextMenu x:Key="LayerContextMenu" Style="{StaticResource LayerContextMenuStyle}">
            <MenuItem Name="AttrTableItem" Header="{DynamicResource AttributeTable}" Style="{StaticResource LayerMenuItem}"
                      Click="AttrTableItem_Click" />
            <MenuItem x:Name="SymbologyItem" Header="Symbology" Style="{StaticResource LayerMenuItem}"
                      Click="SymbologyItem_Click" />
            <MenuItem x:Name="RemoveLayerItem" Header="{DynamicResource Remove}" Style="{StaticResource LayerMenuItem}"
                      Click="RemoveLayerItem_Click" Visibility="Collapsed" />
            <MenuItem x:Name="PropertyLayerItem" Header="{DynamicResource PropMenuHeader}" Style="{StaticResource LayerMenuItem}"
                      Click="PropertyLayerItem_Click" />
        </ContextMenu>

    </UserControl.Resources>

    <Grid Margin="5,5,5,5">
        <Border Background="{StaticResource LayerCardBackground}"
                BorderBrush="{StaticResource LayerBorderBrush}" BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource LayerHeaderBackground}" CornerRadius="3,3,0,0" Height="30">
                    <Grid>
                        <Rectangle Width="3" HorizontalAlignment="Left" Fill="{StaticResource LayerAccentBrush}" />
                        <TextBlock Text="{DynamicResource LayerManagerTxt}" Style="{StaticResource LayerGroupTitle}"
                                   Margin="11,0,10,0" />
                    </Grid>
                </Border>

                <TreeView Grid.Row="1" x:Name="treeView1" Margin="4" Style="{StaticResource LayerTreeViewStyle}"
                          ItemContainerStyle="{StaticResource LayerItemStyle}"
                          SelectedItemChanged="LayerTree_SelectedItemChanged" PreviewMouseRightButtonDown="LayerTree_PreviewMouseRightButtonDown"
                          ContextMenu="{StaticResource LayerContextMenu}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Path=Children, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Margin="0,1"
                                        ToolTipService.ToolTip="{Binding Path=Description, Mode=OneWay}">
                                <CheckBox IsChecked="{Binding Path=IsOn, Mode=TwoWay}" Style="{StaticResource LayerCheckBox}"
                                          Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Path=Name, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
