<Controls:MetroWindow x:Class="Heiflow.Visualization.Studio.Views.GridClipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Title="模型网格剖切" Height="540" Width="460"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        ResizeMode="CanMinimize" GlowBrush="{DynamicResource AccentColorBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 总开关 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <CheckBox x:Name="chkEnabled" Content="启用剖切显示" FontSize="14" FontWeight="Bold"
                      VerticalAlignment="Center" Checked="chkEnabled_Changed" Unchecked="chkEnabled_Changed" />
            <Button x:Name="btnReloadBounds" Content="载入网格范围" MinWidth="100"
                    DockPanel.Dock="Right" HorizontalAlignment="Right" Click="btnReloadBounds_Click" />
        </DockPanel>

        <TextBlock Grid.Row="1" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="Gray"
                   Text="拖动滑块沿模型自身的 X（东）、Y（北）、Z（垂向）方向剖切模型网格，取值为网格范围沿该方向的百分比位置，区间之外的网格体将被裁掉。" />

        <!-- X -->
        <GroupBox Grid.Row="2" Margin="0,0,0,8" Header="X 方向（东—西）">
            <StackPanel Margin="4">
                <DockPanel>
                    <CheckBox x:Name="chkX" Content="启用" VerticalAlignment="Center"
                              Width="70" Checked="Axis_Changed" Unchecked="Axis_Changed" />
                    <TextBlock x:Name="txtXRange" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Foreground="Gray" />
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="起点" Width="40" VerticalAlignment="Center" />
                    <Slider x:Name="sldXStart" Minimum="0" Maximum="1" Value="0"
                            TickFrequency="0.01" IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True" ValueChanged="Axis_Changed" />
                    <TextBlock x:Name="txtXStart" Width="52" Margin="6,0,0,0"
                               VerticalAlignment="Center" TextAlignment="Right" />
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="终点" Width="40" VerticalAlignment="Center" />
                    <Slider x:Name="sldXEnd" Minimum="0" Maximum="1" Value="1"
                            TickFrequency="0.01" IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True" ValueChanged="Axis_Changed" />
                    <TextBlock x:Name="txtXEnd" Width="52" Margin="6,0,0,0"
                               VerticalAlignment="Center" TextAlignment="Right" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <!-- Y -->
        <GroupBox Grid.Row="3" Margin="0,0,0,8" Header="Y 方向（南—北）">
            <StackPanel Margin="4">
                <DockPanel>
                    <CheckBox x:Name="chkY" Content="启用" VerticalAlignment="Center"
                              Width="70" Checked="Axis_Changed" Unchecked="Axis_Changed" />
                    <TextBlock x:Name="txtYRange" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Foreground="Gray" />
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="起点" Width="40" VerticalAlignment="Center" />
                    <Slider x:Name="sldYStart" Minimum="0" Maximum="1" Value="0"
                            TickFrequency="0.01" IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True" ValueChanged="Axis_Changed" />
                    <TextBlock x:Name="txtYStart" Width="52" Margin="6,0,0,0"
                               VerticalAlignment="Center" TextAlignment="Right" />
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="终点" Width="40" VerticalAlignment="Center" />
                    <Slider x:Name="sldYEnd" Minimum="0" Maximum="1" Value="1"
                            TickFrequency="0.01" IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True" ValueChanged="Axis_Changed" />
                    <TextBlock x:Name="txtYEnd" Width="52" Margin="6,0,0,0"
                               VerticalAlignment="Center" TextAlignment="Right" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <!-- Z -->
        <GroupBox Grid.Row="4" Margin="0,0,0,8" Header="Z 方向（垂向）">
            <StackPanel Margin="4">
                <DockPanel>
                    <CheckBox x:Name="chkZ" Content="启用" VerticalAlignment="Center"
                              Width="70" Checked="Axis_Changed" Unchecked="Axis_Changed" />
                    <TextBlock x:Name="txtZRange" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Foreground="Gray" />
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="起点" Width="40" VerticalAlignment="Center" />
                    <Slider x:Name="sldZStart" Minimum="0" Maximum="1" Value="0"
                            TickFrequency="0.01" IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True" ValueChanged="Axis_Changed" />
                    <TextBlock x:Name="txtZStart" Width="52" Margin="6,0,0,0"
                               VerticalAlignment="Center" TextAlignment="Right" />
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="终点" Width="40" VerticalAlignment="Center" />
                    <Slider x:Name="sldZEnd" Minimum="0" Maximum="1" Value="1"
                            TickFrequency="0.01" IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True" ValueChanged="Axis_Changed" />
                    <TextBlock x:Name="txtZEnd" Width="52" Margin="6,0,0,0"
                               VerticalAlignment="Center" TextAlignment="Right" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <DockPanel Grid.Row="5" Margin="0,4,0,0">
            <Button x:Name="btnReset" Content="重置" MinWidth="90" Click="btnReset_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnClose" Content="关闭" MinWidth="90" Click="btnClose_Click" />
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="6" x:Name="txtStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="Gray"
                   VerticalAlignment="Bottom" />
    </Grid>
</Controls:MetroWindow>
