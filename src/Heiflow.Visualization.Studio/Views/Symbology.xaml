<UserControl x:Class="Heiflow.Visualization.Studio.Controls.Symbology"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wpfx="clr-namespace:Microsoft.Windows.Controls;assembly=WPFToolkit.Extended"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="300">
    <Grid Background="{DynamicResource CommonBrush}">
        <StackPanel>
            <Expander Header="{DynamicResource ColorSettingTxt}" IsExpanded="True" Margin="3" ExpandDirection="Down"   Foreground="{DynamicResource InputFontColor}">
                <Grid  Background="{StaticResource PanelGradientBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.8*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="30"></RowDefinition>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Current Layer Name"  VerticalAlignment="Center" Foreground="{DynamicResource InputFontColor}"  
                                       Margin="2" Grid.Row="0" Grid.Column="0">
                    </TextBlock>
                    <TextBox Text="Layer"  x:Name="tbCurLayer" VerticalAlignment="Center" Foreground="{DynamicResource InputFontColor}"  
                                       Margin="2" Grid.Row="0" Grid.Column="1">
                    </TextBox>
                    <TextBlock Text="Classification Method"  VerticalAlignment="Center" Foreground="{DynamicResource InputFontColor}"  
                                       Margin="2" Grid.Row="1" Grid.Column="0">
                    </TextBlock>
                    <ComboBox IsSynchronizedWithCurrentItem="False" x:Name="cobClassMethod"  VerticalAlignment="Center" 
                                           Margin="2"   Grid.Row="1" Grid.Column="1" SelectedIndex="0" SelectionChanged="CobClassMethod_SelectionChanged">
                        <ComboBoxItem>Natural Breaks</ComboBoxItem>
                        <ComboBoxItem>Equal Inteval</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="{DynamicResource ColorRampTxt}"  VerticalAlignment="Center" Foreground="{DynamicResource InputFontColor}"  
                                       Margin="2" Grid.Row="2" Grid.Column="0">
                    </TextBlock>
                    <ComboBox IsSynchronizedWithCurrentItem="False" x:Name="cobColorRamp"  VerticalAlignment="Center" 
                                            Margin="2"   Grid.Row="2" Grid.Column="1"
                                              SelectionChanged="cobColorRamp_SelectionChanged" SelectedIndex="0">
                    </ComboBox>
                    <TextBlock Text="{DynamicResource ClsfyContTxt}"  VerticalAlignment="Center" Foreground="{DynamicResource InputFontColor}"
                                         Margin="2" Grid.Row="3" Grid.Column="0" ></TextBlock>
                    <ComboBox IsSynchronizedWithCurrentItem="False" x:Name="cobColorRampCount"  VerticalAlignment="Center" 
                                       Margin="2"    Grid.Row="3" Grid.Column="2" 
                                              SelectionChanged="cobColorRampCount_SelectionChanged" SelectedIndex="0">
                    </ComboBox>
                    <TextBlock Text="{DynamicResource OpacityTxt}"  VerticalAlignment="Center" Foreground="{DynamicResource InputFontColor}"
                                        Margin="2"  Grid.Row="4" Grid.Column="0" ></TextBlock>
                    <Slider x:Name="sliderOpacity" Margin="2"  Value="255"  SmallChange="1.0" Maximum="255" Minimum="0" 
                            Interval="1" TickFrequency="1"   IsSnapToTickEnabled="True" Orientation="Horizontal"   Style="{DynamicResource Horizontal_Slider}"
                                                       ValueChanged="sliderOpacity_ValueChanged"   Grid.Row="5" Grid.ColumnSpan="2">
                    </Slider>
                    <CheckBox x:Name="chbUniqueColor" VerticalAlignment="Center"  Foreground="{DynamicResource InputFontColor}" Grid.Row="6" Grid.Column="0"
                                                 Margin="2" Unchecked="chbUniqueColor_Checked" Checked="chbUniqueColor_Checked" Content="{DynamicResource UniqueColorTxt}"></CheckBox>
                    <CheckBox x:Name="chbInvertColor" VerticalAlignment="Center"  Foreground="{DynamicResource InputFontColor}" Grid.Row="7" Grid.Column="0"
                                                 Margin="2" Unchecked="chbInvertColor_Checked" Checked="chbInvertColor_Checked" Content="Invert Color"></CheckBox>
                </Grid>
            </Expander>
     
            <Expander Header="Vector" x:Name="expVelocity" IsExpanded="True" Margin="3" ExpandDirection="Down"  Foreground="{DynamicResource InputFontColor}">
                <Grid  Background="{StaticResource PanelGradientBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.8*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="40"></RowDefinition>
                        <RowDefinition Height="40"></RowDefinition>
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="chbVelocityAutoColor" VerticalAlignment="Center"  Foreground="{DynamicResource InputFontColor}"  Margin="2"
                                                  Unchecked="chbVelocityAutoColor_Checked" Checked="chbVelocityAutoColor_Checked" IsChecked="True"
                                  Content="{DynamicResource AutoVecColorTxt}"  Grid.Row="0" Grid.Column="0"></CheckBox>
                    <TextBlock Text="{DynamicResource ScaleVecTxt}"  VerticalAlignment="Center" Foreground="{DynamicResource InputFontColor}"  
                                   Margin="2" Grid.Row="1" Grid.Column="0"></TextBlock>
                    <ComboBox IsSynchronizedWithCurrentItem="False" x:Name="cobVVScale"  VerticalAlignment="Center" 
                                           Margin="2"   SelectionChanged="cobVVScale_SelectionChanged" SelectedIndex="0" Grid.Row="1" Grid.Column="1"
                                  ToolTip="{DynamicResource ScaleVecTipTxt}">
                        <ComboBoxItem Content="{DynamicResource NoneScaleTxt}"></ComboBoxItem>
                        <ComboBoxItem Content="{DynamicResource LinearScaleTxt}"></ComboBoxItem>
                        <ComboBoxItem Content="{DynamicResource SdScaleTxt}"></ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="{DynamicResource VecSizeTxt}"  VerticalAlignment="Center" Foreground="{DynamicResource InputFontColor}"   
                                   Margin="2"  Grid.Row="2" Grid.Column="0"></TextBlock>
                    <ComboBox IsSynchronizedWithCurrentItem="False" x:Name="cobVectorArrow"    Margin="2"      Grid.Row="2" Grid.Column="1"
                        SelectionChanged="cobVectorArrow_SelectionChanged" SelectedIndex="1">
                        <ComboBoxItem IsSelected="False" Tag="100" Content="{DynamicResource SmallTxt}"></ComboBoxItem>
                        <ComboBoxItem IsSelected="True" Tag="200" Content="{DynamicResource NormalTxt}"></ComboBoxItem>
                        <ComboBoxItem IsSelected="False" Tag="400" Content="{DynamicResource LargeTxt}"></ComboBoxItem>
                        <ComboBoxItem IsSelected="False" Tag="800" Content="{DynamicResource VerylargeTxt}"></ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Vector Tile Count"  VerticalAlignment="Center" Foreground="{DynamicResource InputFontColor}"   
                                   Margin="2"  Grid.Row="3" Grid.Column="0"></TextBlock>
                    <ComboBox IsSynchronizedWithCurrentItem="False" x:Name="cobTileCount"    Margin="2"      Grid.Row="3" Grid.Column="1"
                        SelectionChanged="cobTileCount_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem >1</ComboBoxItem>
                        <ComboBoxItem >2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                    </ComboBox>
                    <Button Margin="2,5,5,5" x:Name="btnVelocityStyleProperty" Content="{DynamicResource MoreTxt}" 
                                                     Click="btnVelocityStyleProperty_Click"   Grid.Row="4" Grid.Column="0" Visibility="Collapsed"/>
                </Grid>
            </Expander>        
        </StackPanel>
    </Grid>
</UserControl>
