<UserControl x:Class="Heiflow.Visualization.Studio.Controls.Symbology"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"  Background="{DynamicResource CommonBrush}"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             d:DesignHeight="420" d:DesignWidth="300">
    <!-- Redrawn so that it looks like the scene panel: same palette, same card per group, same property
         grid, and the panel scrolls inside its own scroller. Only the way it is drawn changed, the names
         of the controls and their event handlers are exactly the ones Symbology.xaml.cs expects.

         Two things of the old markup are gone with it. The panel had no scroller at all, so the lower
         part of the vector section was out of reach in a small window. And the classification count
         combo sat in Grid.Column="2" of a grid that only declares two columns, which squeezed it into an
         empty third column instead of putting it next to the other editors.

         The styles live in this file on purpose: they belong to this panel only and must not change the
         look of the other views. -->
    <UserControl.Resources>

        <!-- Palette of the panel, taken from the dark skin of the application. -->
        <SolidColorBrush x:Key="SymSectionBackground" Color="#FF26272B" />
        <SolidColorBrush x:Key="SymHeaderBackground" Color="#FF31333A" />
        <SolidColorBrush x:Key="SymControlBackground" Color="#FF1E1F23" />
        <SolidColorBrush x:Key="SymDropDownBackground" Color="#FF2A2C31" />
        <SolidColorBrush x:Key="SymBorderBrush" Color="#FF3B3E46" />
        <SolidColorBrush x:Key="SymHoverBrush" Color="#FF3A3D45" />
        <SolidColorBrush x:Key="SymAccentBrush" Color="#FF4EA1DE" />
        <SolidColorBrush x:Key="SymTextBrush" Color="#FFE8EAED" />
        <SolidColorBrush x:Key="SymLabelBrush" Color="#FFAEB4BF" />
        <SolidColorBrush x:Key="SymTrackBrush" Color="#FF141518" />
        <SolidColorBrush x:Key="SymTickBrush" Color="#FF6E747E" />
        <SolidColorBrush x:Key="SymThumbFill" Color="#FF2F3137" />

        <!-- Label of a property, the controls of every section start at the same offset. -->
        <Style x:Key="SymFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SymLabelBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>

        <!-- Current value of a slider, shown right aligned above the track. -->
        <Style x:Key="SymValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SymTextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- Header of a group. -->
        <Style x:Key="SymGroupTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SymTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SymSliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="12" Height="12" Fill="{StaticResource SymThumbFill}"
                                 Stroke="{StaticResource SymAccentBrush}" StrokeThickness="1.5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SymTrackFillButton" TargetType="RepeatButton">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{StaticResource SymAccentBrush}" Height="4" CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SymTrackButton" TargetType="RepeatButton">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{StaticResource SymTrackBrush}" Height="4" CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat slider with a thin track. No ticks are shown, the opacity runs from 0 to 255 by one and a
             tick bar would be nothing but a grey block. -->
        <Style x:Key="SymSlider" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="TickPlacement" Value="None" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TickBar x:Name="TopTick" Grid.Row="0" Height="4" Placement="Top"
                                     Fill="{StaticResource SymTickBrush}" Visibility="Collapsed" />
                            <Grid Grid.Row="1" Height="16">
                                <Border Height="4" CornerRadius="2" Background="{StaticResource SymTrackBrush}" />
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SymTrackFillButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SymSliderThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SymTrackButton}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <TickBar x:Name="BottomTick" Grid.Row="2" Height="4" Placement="Bottom"
                                     Fill="{StaticResource SymTickBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="TickPlacement" Value="TopLeft">
                                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="TickPlacement" Value="BottomRight">
                                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="TickPlacement" Value="Both">
                                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SymComboBoxToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{StaticResource SymControlBackground}"
                                BorderBrush="{StaticResource SymBorderBrush}" BorderThickness="1" CornerRadius="3">
                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource SymLabelBrush}" StrokeThickness="1.5"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SymAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SymAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SymComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource SymTextBrush}" />
            <Setter Property="Padding" Value="6,4,6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SymHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SymAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF7A7A7A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SymComboBox" TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource SymTextBrush}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SymComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource SymComboBoxToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter IsHitTestVisible="False" Margin="7,0,22,0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   PopupAnimation="Slide" AllowsTransparency="True" Focusable="False">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220" Margin="0,2,0,0"
                                        Background="{StaticResource SymDropDownBackground}"
                                        BorderBrush="{StaticResource SymBorderBrush}" BorderThickness="1" CornerRadius="3">
                                    <ScrollViewer Margin="2" Foreground="{StaticResource SymTextBrush}">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Read only line holding the name of the layer that is being styled. -->
        <Style x:Key="SymTextBox" TargetType="TextBox">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource SymTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{StaticResource SymControlBackground}"
                                BorderBrush="{StaticResource SymBorderBrush}" BorderThickness="1" CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="6,0,6,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SymAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SymCheckBox" TargetType="CheckBox">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource SymTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="14" Height="14" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{StaticResource SymControlBackground}"
                                    BorderBrush="{StaticResource SymBorderBrush}" BorderThickness="1">
                                <Path x:Name="Check" Data="M 2,7 L 6,11 L 12,3" Stroke="{StaticResource SymAccentBrush}"
                                      StrokeThickness="2" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SymAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SymAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SymButton" TargetType="Button">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource SymTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource SymControlBackground}"
                                BorderBrush="{StaticResource SymBorderBrush}" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SymHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SymAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SymAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Every section is a card: a header with an accent bar and a body that holds the properties. -->
        <Style x:Key="SymExpander" TargetType="Expander">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource SymTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{StaticResource SymSectionBackground}"
                                BorderBrush="{StaticResource SymBorderBrush}" BorderThickness="1" CornerRadius="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ToggleButton Grid.Row="0" Focusable="False"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ToolTip="{TemplateBinding Header}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderBd" Background="{StaticResource SymHeaderBackground}"
                                                    CornerRadius="3,3,0,0" Padding="0" SnapsToDevicePixels="True">
                                                <Grid Height="30">
                                                    <Rectangle Width="3" HorizontalAlignment="Left" Fill="{StaticResource SymAccentBrush}" />
                                                    <ContentPresenter Margin="11,0,10,0" VerticalAlignment="Center" />
                                                    <Path x:Name="Chevron" Data="M 0 0 L 4 4 L 0 8"
                                                          Stroke="{StaticResource SymLabelBrush}" StrokeThickness="1.5"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"
                                                          RenderTransformOrigin="0.5,0.5" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderBd" Property="Background" Value="{StaticResource SymHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}" />
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite" Grid.Row="1" Margin="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0" Background="Transparent">
        <StackPanel Margin="5,5,5,5">

            <Expander x:Name="expColorSetting" Style="{StaticResource SymExpander}">
                <Expander.Header>
                    <TextBlock Text="{DynamicResource ColorSettingTxt}" Style="{StaticResource SymGroupTitle}" />
                </Expander.Header>
                <Grid Margin="11,9,11,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Current Layer Name" Style="{StaticResource SymFieldLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="tbCurLayer" Text="Layer" Style="{StaticResource SymTextBox}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Classification Method" Style="{StaticResource SymFieldLabel}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cobClassMethod" Style="{StaticResource SymComboBox}"
                              IsSynchronizedWithCurrentItem="False" SelectedIndex="0"
                              SelectionChanged="CobClassMethod_SelectionChanged">
                        <ComboBoxItem>Natural Breaks</ComboBoxItem>
                        <ComboBoxItem>Equal Inteval</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource ColorRampTxt}" Style="{StaticResource SymFieldLabel}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cobColorRamp" Style="{StaticResource SymComboBox}"
                              IsSynchronizedWithCurrentItem="False" SelectedIndex="0"
                              SelectionChanged="cobColorRamp_SelectionChanged" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource ClsfyContTxt}" Style="{StaticResource SymFieldLabel}" />
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cobColorRampCount" Style="{StaticResource SymComboBox}"
                              IsSynchronizedWithCurrentItem="False" SelectedIndex="0"
                              SelectionChanged="cobColorRampCount_SelectionChanged" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource OpacityTxt}" Style="{StaticResource SymFieldLabel}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource SymValueText}"
                               Text="{Binding Value, ElementName=sliderOpacity, StringFormat={}{0:F0}}" />

                    <Slider Grid.Row="5" Grid.ColumnSpan="2" x:Name="sliderOpacity" Margin="0,3,0,0"
                            Style="{StaticResource SymSlider}" Value="255" SmallChange="1.0" Minimum="0" Maximum="255"
                            Interval="1" TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="sliderOpacity_ValueChanged" />

                    <CheckBox Grid.Row="6" Grid.ColumnSpan="2" x:Name="chbUniqueColor" Margin="0,8,0,0"
                              Style="{StaticResource SymCheckBox}"
                              Unchecked="chbUniqueColor_Checked" Checked="chbUniqueColor_Checked"
                              Content="{DynamicResource UniqueColorTxt}" />
                    <CheckBox Grid.Row="7" Grid.ColumnSpan="2" x:Name="chbInvertColor" Margin="0,6,0,0"
                              Style="{StaticResource SymCheckBox}"
                              Unchecked="chbInvertColor_Checked" Checked="chbInvertColor_Checked"
                              Content="Invert Color" />
                    <CheckBox Grid.Row="8" Grid.ColumnSpan="2" x:Name="chbContinuousColor" Margin="0,6,0,0"
                              Style="{StaticResource SymCheckBox}"
                              Unchecked="chbContinuousColor_Checked" Checked="chbContinuousColor_Checked"
                              ToolTip="Scale the values over one range for the whole run instead of putting them in classes, so that a step changes the shade of a vertex rather than the scale underneath it."
                              Content="Continuous Shading" />
                    <CheckBox Grid.Row="9" Grid.ColumnSpan="2" x:Name="chbShadedLighting" Margin="0,6,0,0"
                              Style="{StaticResource SymCheckBox}"
                              Unchecked="chbShadedLighting_Checked" Checked="chbShadedLighting_Checked"
                              ToolTip="Let the sun and the ambient take a shade off the colours, the way the fixed pipeline lit a layer. Off draws every colour as the ramp gives it."
                              Content="Sun Shading" />
                </Grid>
            </Expander>

            <!-- The shape of the grid itself. Only a grid layer has one to give it. -->
            <Expander x:Name="expGrid" Style="{StaticResource SymExpander}"
                      IsEnabled="{Binding IsModelGrid, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Expander.Header>
                    <TextBlock Text="Grid" Style="{StaticResource SymGroupTitle}"
                               ToolTipService.ShowOnDisabled="True"
                               ToolTip="How the grid of the model is drawn. The group is switched off for a layer that has no grid." />
                </Expander.Header>
                <Grid Margin="11,9,11,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Grid Shape" Style="{StaticResource SymFieldLabel}"
                               ToolTip="How much of the third dimension the grid is drawn with." />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cobGridShape" Style="{StaticResource SymComboBox}"
                              IsSynchronizedWithCurrentItem="False" SelectedIndex="0"
                              SelectionChanged="cobGridShape_SelectionChanged"
                              ToolTip="Flat draws the top of the layer as a sheet. Layer hangs walls off it down to the floor of that layer, so that a layer is a body one layer thick. Model hangs them down to the floor of the model, so that the whole of it is one body. Layers draws a face on the top of every layer, so that the grid is a stack of them. Boundary draws the sheet and hangs walls off the outside of it, down to the floor of the model, and gives a foot to no vertex but the ones on the outside, which is what a body costs a small part of.">
                        <ComboBoxItem>Flat</ComboBoxItem>
                        <ComboBoxItem>Layer</ComboBoxItem>
                        <ComboBoxItem>Model</ComboBoxItem>
                        <ComboBoxItem>Layers</ComboBoxItem>
                        <ComboBoxItem>Boundary</ComboBoxItem>
                    </ComboBox>
                </Grid>
            </Expander>

            <!-- Only a vector layer has anything for this group to say, so it is switched off for every
                 other kind of layer rather than left looking like it would change something. -->
            <Expander x:Name="expVelocity" Style="{StaticResource SymExpander}"
                      IsEnabled="{Binding IsVectorLayer, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Expander.Header>
                    <!-- The title says why the group is greyed out, which a hint on the whole group
                         would not: the header is what the pointer comes to rest on. -->
                    <TextBlock Text="Vector" Style="{StaticResource SymGroupTitle}"
                               ToolTipService.ShowOnDisabled="True"
                               ToolTip="How a vector layer is drawn: the arrows on the cells, or the lines traced through the flow. The group is switched off for every other kind of layer." />
                </Expander.Header>
                <Grid Margin="11,9,11,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.ColumnSpan="2" x:Name="chbVelocityAutoColor" Margin="0,0,0,9"
                              Style="{StaticResource SymCheckBox}" IsChecked="True"
                              Unchecked="chbVelocityAutoColor_Checked" Checked="chbVelocityAutoColor_Checked"
                              Content="{DynamicResource AutoVecColorTxt}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource ScaleVecTxt}" Style="{StaticResource SymFieldLabel}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cobVVScale" Style="{StaticResource SymComboBox}"
                              IsSynchronizedWithCurrentItem="False" SelectedIndex="0"
                              SelectionChanged="cobVVScale_SelectionChanged"
                              ToolTip="{DynamicResource ScaleVecTipTxt}">
                        <ComboBoxItem Content="{DynamicResource NoneScaleTxt}"></ComboBoxItem>
                        <ComboBoxItem Content="{DynamicResource LinearScaleTxt}"></ComboBoxItem>
                        <ComboBoxItem Content="{DynamicResource SdScaleTxt}"></ComboBoxItem>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource VecSizeTxt}" Style="{StaticResource SymFieldLabel}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cobVectorArrow" Style="{StaticResource SymComboBox}"
                              SelectedIndex="1" SelectionChanged="cobVectorArrow_SelectionChanged">
                        <ComboBoxItem IsSelected="False" Tag="100" Content="{DynamicResource SmallTxt}"></ComboBoxItem>
                        <ComboBoxItem IsSelected="True" Tag="200" Content="{DynamicResource NormalTxt}"></ComboBoxItem>
                        <ComboBoxItem IsSelected="False" Tag="400" Content="{DynamicResource LargeTxt}"></ComboBoxItem>
                        <ComboBoxItem IsSelected="False" Tag="800" Content="{DynamicResource VerylargeTxt}"></ComboBoxItem>
                    </ComboBox>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Vector Tile Count" Style="{StaticResource SymFieldLabel}" />
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cobTileCount" Style="{StaticResource SymComboBox}"
                              IsSynchronizedWithCurrentItem="False" SelectedIndex="0"
                              SelectionChanged="cobTileCount_SelectionChanged">
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                    </ComboBox>

                    <CheckBox Grid.Row="4" Grid.ColumnSpan="2" x:Name="chbStreamlines" Margin="0,8,0,0"
                              Style="{StaticResource SymCheckBox}"
                              Unchecked="chbStreamlines_Checked" Checked="chbStreamlines_Checked"
                              ToolTip="Draw a line traced through the flow instead of an arrow on every cell. The dashes that run along the lines are drawn by Streamline.fx, and the tile count says how far apart the lines start."
                              Content="Streamlines" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Line Width" Style="{StaticResource SymFieldLabel}"
                               IsEnabled="{Binding IsChecked, ElementName=chbStreamlines}"
                               ToolTip="How wide a line is drawn, in pixels." />
                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="cobStreamlineWidth" Style="{StaticResource SymComboBox}"
                              IsSynchronizedWithCurrentItem="False" SelectedIndex="1"
                              IsEnabled="{Binding IsChecked, ElementName=chbStreamlines}"
                              SelectionChanged="cobStreamlineWidth_SelectionChanged">
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Flow Speed" Style="{StaticResource SymFieldLabel}"
                               IsEnabled="{Binding IsChecked, ElementName=chbStreamlines}"
                               ToolTip="How fast a dash runs along a line, in cells of the grid a second." />
                    <ComboBox Grid.Row="6" Grid.Column="1" x:Name="cobFlowSpeed" Style="{StaticResource SymComboBox}"
                              IsSynchronizedWithCurrentItem="False" SelectedIndex="1"
                              IsEnabled="{Binding IsChecked, ElementName=chbStreamlines}"
                              SelectionChanged="cobFlowSpeed_SelectionChanged">
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Fade Time" Style="{StaticResource SymFieldLabel}"
                               IsEnabled="{Binding IsChecked, ElementName=chbStreamlines}"
                               ToolTip="How long a dash stays lit behind its head, in seconds. A longer time leaves a longer trail." />
                    <ComboBox Grid.Row="7" Grid.Column="1" x:Name="cobFadeTime" Style="{StaticResource SymComboBox}"
                              IsSynchronizedWithCurrentItem="False" SelectedIndex="1"
                              IsEnabled="{Binding IsChecked, ElementName=chbStreamlines}"
                              SelectionChanged="cobFadeTime_SelectionChanged">
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2.5</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>10</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Line Spacing" Style="{StaticResource SymFieldLabel}"
                               IsEnabled="{Binding IsChecked, ElementName=chbStreamlines}"
                               ToolTip="How many cells a line keeps clear around itself. A line stops where another one already runs within this many cells, so that two lines neither lie over each other nor cross. Off lets them run where they will." />
                    <ComboBox Grid.Row="8" Grid.Column="1" x:Name="cobStreamlineSpacing" Style="{StaticResource SymComboBox}"
                              IsSynchronizedWithCurrentItem="False" SelectedIndex="1"
                              IsEnabled="{Binding IsChecked, ElementName=chbStreamlines}"
                              SelectionChanged="cobStreamlineSpacing_SelectionChanged">
                        <ComboBoxItem>Off</ComboBoxItem>
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                    </ComboBox>

                    <Button Grid.Row="9" Grid.ColumnSpan="2" x:Name="btnVelocityStyleProperty" Margin="0,9,0,0"
                            Style="{StaticResource SymButton}" Content="{DynamicResource MoreTxt}"
                            Click="btnVelocityStyleProperty_Click" Visibility="Collapsed" />
                </Grid>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
