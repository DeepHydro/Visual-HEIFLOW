<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared look of the trees shown in the shell (layer manager, project explorer). The framework
         tree paints itself light grey, which does not fit the dark skin of the application. -->
    <SolidColorBrush x:Key="LayerTreeTextBrush" Color="#FFE8E8EC" />
    <SolidColorBrush x:Key="LayerTreeGlyphBrush" Color="#FF9A9AA2" />
    <SolidColorBrush x:Key="LayerTreeHoverBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="LayerTreeSelectedBrush" Color="#FF3A3D45" />

    <Style x:Key="LayerTreeExpandCollapseToggleStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent" Width="14" Height="14">
                        <Path x:Name="Arrow" Data="M 1,0 L 6,4 L 1,8 Z" Fill="{StaticResource LayerTreeGlyphBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="Data" Value="M 0,1 L 8,1 L 4,7 Z" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Fill" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LayerTreeViewItemStyle" TargetType="{x:Type TreeViewItem}">
        <Setter Property="Foreground" Value="{StaticResource LayerTreeTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="2,2,6,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0"
                                      Style="{StaticResource LayerTreeExpandCollapseToggleStyle}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ClickMode="Press" />
                        <Border x:Name="HeaderBorder" Grid.Row="0" Grid.Column="1" Background="Transparent"
                                CornerRadius="2" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource LayerTreeSelectedBrush}" />
                        </Trigger>
                        <!-- The hover is taken from the header row and not from the item itself: a
                             TreeViewItem reports IsMouseOver for its whole sub tree, so every ancestor of
                             the row under the cursor would light up as well. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False" />
                                <Condition SourceName="HeaderBorder" Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource LayerTreeHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FF7A7A7A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LayerTreeViewStyle" TargetType="{x:Type TreeView}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource LayerTreeTextBrush}" />
        <Setter Property="Padding" Value="2" />
        <!-- Containers are created per item instead of being recycled. A recycled container keeps the
             selected state it had for another item, which paints more than one row as selected. -->
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Standard" />
    </Style>
</ResourceDictionary>
