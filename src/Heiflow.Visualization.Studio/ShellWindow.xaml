        <Grid x:Name="MainGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- the 3D scene takes all remaining space and is never squeezed away by the splitter -->
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <!-- right side panel: resizable, but kept within reasonable bounds -->
                <ColumnDefinition Width="300" MinWidth="180" MaxWidth="520" />
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0" Content="{Binding  ShellService.VirtualGlobeView}">
            </ContentControl>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Margin="0" Padding="0" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource CommonBrush}"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- header of the side panel, it stays visible when the panel is collapsed -->
                <Border Grid.Row="0" Height="30" Background="{DynamicResource CommonBrush}">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="btnCollapseRightPanel" DockPanel.Dock="Right" Width="28" Height="28"
                                VerticalAlignment="Center" Margin="0,0,2,0" ToolTip="Collapse / expand the panel"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="btnCollapseRightPanel_Click">
                            <Button.Content>
                                <TextBlock Text="&#x21D4;" Foreground="White" FontSize="13" FontWeight="Bold"></TextBlock>
                            </Button.Content>
                        </Button>
                        <TextBlock Text="Panels" Foreground="White" FontWeight="Bold" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0"></TextBlock>
                    </DockPanel>
                </Border>
                <!-- layers and scene settings share the same dock, both are height constrained so that
                     their content scrolls inside the panel instead of running past the window -->
                <TabControl x:Name="RightPanelTabs" Grid.Row="1" Style="{StaticResource SidePanelTabControl}">
                    <TabItem Header="Layers">
                        <ContentControl Content="{Binding ShellService.LayerManager}"></ContentControl>
                    </TabItem>
                    <TabItem Header="Scene">
                        <localct:SceneSetting></localct:SceneSetting>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <Border x:Name="ActivicationPanel" Grid.Row="1" Visibility="Collapsed">
            <localct:Activication VerticalAlignment="Center" HorizontalAlignment="Center" Width="500" Height="250"  Activated="Activication_Activated"></localct:Activication>
        </Border>
    </Grid>
</Controls:MetroWindow>
